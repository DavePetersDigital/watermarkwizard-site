# Copy to .env.local for local dev. Set the same NEXT_PUBLIC_* vars in Vercel.

NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Must match Fly secret PADDLE_LICENSE_PRICE_ID (same pri_... as Paddle catalog)
NEXT_PUBLIC_PADDLE_LICENSE_ID=

# Optional legacy fallback (same as old NEXT_PUBLIC_PADDLE_CREATOR_ID)
# NEXT_PUBLIC_PADDLE_CREATOR_ID=

NEXT_PUBLIC_ENABLE_CHECKOUT=true
